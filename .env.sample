# Copy this file to .env. Keep .env local and do not commit real credentials.

# Required for discover_partner_content.py.
BRAVE_API_KEY=

# Optional for check_partner_repositories.py. Add this for larger repository batches.
GITHUB_TOKEN=

# Optional settings for both read-only discovery scripts.
DISCOVERY_OUTPUT_DIR=private/reports
REQUEST_TIMEOUT_SECONDS=30
